{
  "name": "obix-core-reactive",
  "version": "0.5.0",
  "description": "OBIX Reactive projection — current state, frozen props, subscribers, changedKeys, effects lifecycle. Action execution routes through obix-core-ir applyAction. Depends on obix-core-spec, obix-core-ir and obix-core-scheduler (effects). Not the reactive controller / mount loop that an older package of the same name published (docs/recovery/naming-migration.md).",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-core-ir": "0.5.0",
    "obix-core-scheduler": "0.5.0",
    "obix-core-spec": "0.5.0"
  },
  "devDependencies": {
    "obix-fixture-timer": "0.5.0"
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-core-reactive.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-core-reactive/issues"
  },
  "homepage": "https://github.com/obinexus/obix-core-reactive#readme"
}
